<mxfile host="app.diagrams.net"><diagram id="task2-reports" name="BionicPRO C4 — Сервис отчётов">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageScale="1" pageWidth="1700" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="1240" height="800" as="geometry"/></mxCell><mxCell id="n3" value="BionicPRO [System] — сервис отчётов (ETL → OLAP → API → S3/CDN)" style="text;html=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="770" width="500" height="30" as="geometry"/></mxCell><mxCell id="n4" value="Пользователь протеза&lt;br&gt;[Person]" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="180" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Приложение&lt;/b&gt;&lt;br&gt;[Container: React]&lt;br&gt;кнопка «Download Report»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="210" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;bionicpro-auth&lt;/b&gt;&lt;br&gt;[Container: Go]&lt;br&gt;сессия → Bearer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="220" height="130" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;reports-api&lt;/b&gt;&lt;br&gt;[Container: Go]&lt;br&gt;GET /reports: только свой отчёт;&lt;br&gt;S3-кеш отчётов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="220" height="130" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;CRM&lt;/b&gt; [System]&lt;br&gt;PostgreSQL (клиенты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="220" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Airflow&lt;/b&gt; [Container]&lt;br&gt;DAG reports_user_daily_etl,&lt;br&gt;расписание 0 3 * * *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="220" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;ClickHouse&lt;/b&gt; [OLAP]&lt;br&gt;телеметрия (KafkaEngine)&lt;br&gt;+ реплика CRM (CDC)&lt;br&gt;→ витрина reports_user_daily&lt;br&gt;(MaterializedView)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="250" height="160" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Minio&lt;/b&gt; [S3]&lt;br&gt;reports/user=&amp;lt;sub&amp;gt;/&amp;lt;from&amp;gt;_&amp;lt;to&amp;gt;.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="250" height="110" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Nginx CDN&lt;/b&gt; [Container]&lt;br&gt;reverse proxy + cache 10m&lt;br&gt;/reports-cdn/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="250" height="100" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Чипы протезов&lt;/b&gt;&lt;br&gt;[System] 4G-поток телеметрии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="220" height="100" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Kafka&lt;/b&gt; + Kafka Connect&lt;br&gt;Debezium CDC из CRM;&lt;br&gt;топик telemetry.prosthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="220" height="110" as="geometry"/></mxCell><mxCell id="n15" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="Bearer access_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="SELECT из витрины&lt;br&gt;(без вычислений на лету)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="PUT/HEAD отчёта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="report_url (CDN-ссылка)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="460"/><mxPoint x="620" y="420"/></Array></mxGeometry></mxCell><mxCell id="n21" value="proxy_cache: HIT→отдаёт из кеша
MISS→GET из Minio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n12" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="телеметрия (JSONEachRow)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="Extract: клиенты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="135"/></Array></mxGeometry></mxCell><mxCell id="n24" value="Load: витрина (ETL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="CDC: Debezium (WAL)&lt;n&gt;топик crm.public.clients" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="130"/><mxPoint x="510" y="695"/></Array></mxGeometry></mxCell><mxCell id="n26" value="KafkaEngine consume → MaterializedView" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n14" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="695"/><mxPoint x="940" y="695"/><mxPoint x="940" y="330"/></Array></mxGeometry></mxCell><mxCell id="n27" value="Решения (Задание 2-4):&lt;br&gt;• ETL (Airflow, батч 03:00) + потоковый CDC (Debezium→Kafka→KafkaEngine) — выгрузки больше не бьют по OLTP CRM.&lt;br&gt;• Витрина reports_user_daily (широкая таблица, ORDER BY user_id) — отчёт = один SELECT.&lt;br&gt;• API проверяет access_token (RS256, публичный ключ Keycloak) и выдаёт отчёт только по своему sub.&lt;br&gt;• Период ограничен последним обработанным днём (max(day) витрины).&lt;br&gt;• Отчёт кладётся в S3, отдаётся через CDN-ссылку; повторные запросы не ходят в ClickHouse.&lt;br&gt;• Обновление кеша: новый период = новый ключ объекта + proxy_cache_valid 10m." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>