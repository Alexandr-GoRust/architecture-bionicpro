<mxfile host="app.diagrams.net"><diagram id="task1-security" name="BionicPRO C4 — Безопасность (to-be)">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageScale="1" pageWidth="1700" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="1240" height="780" as="geometry"/></mxCell><mxCell id="n3" value="BionicPRO [System] — целевая архитектура безопасности" style="text;html=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="730" width="400" height="30" as="geometry"/></mxCell><mxCell id="n4" value="Пользователь протеза&lt;br&gt;[Person]" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="180" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Мобильное/веб-приложение&lt;/b&gt;&lt;br&gt;[Container: React]&lt;br&gt;без токенов: только сессионная&lt;br&gt;cookie HttpOnly+Secure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="230" height="120" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;bionicpro-auth&lt;/b&gt;&lt;br&gt;[Container: Go]&lt;br&gt;• PKCE S256 (Code Grant)&lt;br&gt;• сессии, ротация session id&lt;br&gt;• авто-refresh access-токена&lt;br&gt;• refresh в зашифрованном виде" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="260" height="200" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Keycloak&lt;/b&gt; [IdP]&lt;br&gt;access ≤ 2 мин, refresh включён,&lt;br&gt;MFA (OTP) обязателен" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="250" height="130" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;OpenLDAP&lt;/b&gt; [User Federation]&lt;br&gt;представительство в другой стране:&lt;br&gt;пользователи + группы-роли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="460" width="250" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Яндекс ID&lt;/b&gt; [Identity Provider]&lt;br&gt;Identity Brokering (OIDC):&lt;br&gt;профиль + согласие пользователя" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="610" width="250" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;CRM / сервисы BionicPRO&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;ресурсы: /reports и др." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="260" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;БД (PostgreSQL)&lt;/b&gt;&lt;br&gt;локальное хранение ПДн/медданных&lt;br&gt;страны присутствия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="220" height="110" as="geometry"/></mxCell><mxCell id="n12" value="HTTPS (браузер)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="сессия: Set-Cookie HttpOnly, Secure&lt;br&gt;[credentials: include]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="260"/></Array></mxGeometry></mxCell><mxCell id="n14" value="OAuth 2.0 Authorization Code + PKCE (S256);&lt;br&gt;обмен code↔токены; refresh_token grant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="User Federation: аутентификация&lt;br&gt;и маппинг ролей (групп LDAP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="Identity Brokering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="700"/><mxPoint x="1100" y="700"/></Array></mxGeometry></mxCell><mxCell id="n17" value="Bearer access_token&lt;br&gt;(короткоживущий, только сервер-сервер)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="Решения (Задание 1):&lt;br&gt;1. Унификация доступа: единый Keycloak; учётные записи представительства — во внешнем LDAP своей страны (принцип локальности ПДн соблюдён: в БД BionicPRO хранятся только бизнес-данные).&lt;br&gt;2. Токены не доходят до фронтенда: bionicpro-auth (BFF) — единственный держатель access/refresh; фронт получает сессионную cookie HttpOnly+Secure.&lt;br&gt;3. PKCE S256 вместо чистого Code Grant: перехват кода бесполезен без code_verifier.&lt;br&gt;4. MFA: OTP обязателен для всех (Google Authenticator/FreeOTP).&lt;br&gt;5. Ротация сессии против session fixation; TTL сессии &amp;gt; TTL access для тихого refresh.&lt;br&gt;6. Яндекс ID через Identity Brokering: данные профиля — после согласия пользователя." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="280" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>